# AXIOM-ASTROPHYSICS .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Paper / manuscript workspace (authored locally; exported on submission, not tracked)
paper/
paper/*

# Agent context / execution log workspace
context/
context/*

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/

# C/C++ compiled files
*.o
*.obj
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
Axiom_C/

# Dataset files (large, regenerate as needed)
dataset.json
dataset_test.json
universe_data.json

# Output files (regenerate as needed)
audit_log.json
audit_log_report.txt
test_output.json

# Benchmark report artifacts (regenerated by scripts/generate_reports.py)
benchmarks/charts/
benchmarks/reports/

# Legacy benchmark output directory (superseded by benchmarks/)
Benchmark/

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# OS files
Thumbs.db
desktop.ini

# Documentation build artifacts
docs/_build/
docs/.doctrees/

# Environment variables
.env
.env.local

# Large data files
*.csv
*.tsv
*.dat
*.fits
*.hdf5

# Compressed files
*.zip
*.tar.gz
*.rar
*.7z

# User-specific data and models
data/
*.pkl
*.joblib
*.npz

# Extracted archive working dir (created by axiom/data/real_seti.py)
**/_extracted/

# Legacy scripts (superseded by axiom/ package modules)
scripts/legacy/

# Keep important documentation and config
!README.md
!BENCHMARKS.md
!Makefile
!requirements.txt
!pyproject.toml
!AGENTS.md
!configs/
!docs/
